# Public runtime configuration (safe for client exposure)
NEXT_PUBLIC_APP_URL=https://dottoh.vercel.app
NEXT_PUBLIC_TELEMETRY_ENABLED=true

# Neon PostgreSQL pooled connection string (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js v5 session encryption key (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-at-least-32-character-random-secret

# GitHub OAuth App credentials for /admin authentication (server-only)
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# Comma-separated numeric GitHub User IDs authorized to access /admin
GITHUB_ADMIN_IDS=12345678

# Optional legal/admin contact email displayed on /terms and /privacy
ADMIN_CONTACT_EMAIL=contact@dottoh.app

# Optional Upstash Redis REST credentials for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
